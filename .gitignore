# Build outputs — never commit binaries (use GitHub Releases for archives)
*.apk
*.aab
*.tar.gz
*.zip

# Generated
bin/
gen/
out/
release/

# Logs
*.log
nul

# Working notes
temp/

# AI coding tool caches. .opencode/ also hosts the tracked versioning skill
# (.opencode/skills/kbtv-versioning), so ignore its contents individually and
# keep the skills tree addable — excluding the directory itself would silently
# swallow every new skill file.
.opencode/*
!.opencode/skills/
.omo/
app/.cxx/
app/src/main/cpp/third_party/UxPlay/lib/*.rej

# local tool caches
.video_agent/
.v2c/
__pycache__/
